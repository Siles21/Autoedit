<?xml version="1.0" encoding="UTF-8"?>
<!-- Vorlage: Pfade anpassen, nach ~/Library/LaunchAgents/ kopieren (ohne .example) -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.autoedit.dropbox-watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/ABSOLUTER/PFAD/zum/Autoedit/watcher/dbx_watch.py</string>
        <string>watch</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/ABSOLUTER/PFAD/zum/Autoedit/watcher</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/DEINUSER/Library/Logs/autoedit-watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/DEINUSER/Library/Logs/autoedit-watcher.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
